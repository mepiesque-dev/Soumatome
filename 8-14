// ══════════════════════════════
// STATE
// ══════════════════════════════
let mode = 'jp-id';
let totalCount = 203;
let questions = [];
let current = 0;
let score = 0;
let wrongItems = [];
let answered = false;

function selectMode(m, btn) {
  mode = m;
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
}
function selectCount(n, btn) {
  totalCount = n;
  document.querySelectorAll('.count-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
}

// ══════════════════════════════
// SHUFFLE
// ══════════════════════════════
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

function buildQuestions() {
  const pool = shuffle([...VOCAB]);
  const chosen = pool.slice(0, Math.min(totalCount, VOCAB.length));
  return chosen.map(item => {
    // wrong options: pick 3 random others
    const others = VOCAB.filter(v => v !== item);
    const wrongs = shuffle(others).slice(0, 3);
    const opts = shuffle([item, ...wrongs]);
    return { item, opts };
  });
}

// ══════════════════════════════
// SCREENS
// ══════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function startQuiz() {
  questions = buildQuestions();
  current = 0; score = 0; wrongItems = [];
  showScreen('quizScreen');
  renderQuestion();
}

function renderQuestion() {
  answered = false;
  const { item, opts } = questions[current];
  const total = questions.length;

  // progress
  document.getElementById('progFill').style.width = (current / total * 100) + '%';
  document.getElementById('progLabel').textContent = `${current + 1} / ${total}`;
  document.getElementById('scoreVal').textContent = score;
  document.getElementById('wrongBadge').textContent = `❌ ${wrongItems.length}`;

  // question
  document.getElementById('qDay').textContent = item.day;
  if (mode === 'jp-id') {
    document.getElementById('qText').textContent = item.jp;
    document.getElementById('qReading').textContent = item.read;
  } else {
    document.getElementById('qText').textContent = item.id;
    document.getElementById('qReading').textContent = '';
  }

  // options
  const box = document.getElementById('optionsBox');
  box.innerHTML = '';
  opts.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn';
    if (mode === 'jp-id') {
      btn.textContent = opt.id;
    } else {
      btn.innerHTML = `${opt.jp} <span style="font-weight:400;color:#888;font-size:.82em">(${opt.read})</span>`;
    }
    btn.onclick = () => checkAnswer(opt, item);
    box.appendChild(btn);
  });

  // feedback & next
  const fb = document.getElementById('feedbackBar');
  fb.className = 'feedback-bar';
  fb.textContent = '';
  document.getElementById('nextBtn').className = 'next-btn';
}

function checkAnswer(chosen, correct) {
  if (answered) return;
  answered = true;
  const btns = document.querySelectorAll('.opt-btn');
  btns.forEach(btn => {
    btn.disabled = true;
    const label = mode === 'jp-id' ? btn.textContent : btn.textContent.replace(/\(.*\)/, '').trim();
    const correctLabel = mode === 'jp-id' ? correct.id : correct.jp;
    if (btn.textContent.includes(correct.id) || btn.textContent.includes(correct.jp)) {
      btn.classList.add('correct');
    }
  });

  const fb = document.getElementById('feedbackBar');
  if (chosen === correct) {
    score++;
    fb.textContent = '✅ Benar!';
    fb.className = 'feedback-bar show ok';
  } else {
    wrongItems.push({ q: correct, chosen });
    fb.className = 'feedback-bar show ng';
    if (mode === 'jp-id') {
      fb.textContent = `❌ Jawaban: ${correct.id}`;
    } else {
      fb.textContent = `❌ Jawaban: ${correct.jp} (${correct.read})`;
    }
    btns.forEach(btn => {
      if (btn.textContent.includes(chosen.id) || btn.textContent.includes(chosen.jp)) {
        btn.classList.add('wrong');
      }
    });
  }
  document.getElementById('nextBtn').className = 'next-btn show';
}

function nextQuestion() {
  current++;
  if (current >= questions.length) { showResult(); return; }
  renderQuestion();
}

// ══════════════════════════════
// RESULT
// ══════════════════════════════
function showResult() {
  showScreen('resultScreen');
  const total = questions.length;
  const pct = Math.round(score / total * 100);

  let emoji = '🎉', stars = '⭐⭐⭐⭐⭐', msg = 'Sempurna! Kamu luar biasa!';
  if (pct < 40) { emoji = '😢'; stars = '⭐'; msg = 'Yuk belajar lagi! Jangan menyerah!'; }
  else if (pct < 60) { emoji = '😅'; stars = '⭐⭐'; msg = 'Lumayan, tapi masih bisa lebih baik!'; }
  else if (pct < 75) { emoji = '🙂'; stars = '⭐⭐⭐'; msg = 'Cukup bagus! Terus latihan ya!'; }
  else if (pct < 90) { emoji = '😊'; stars = '⭐⭐⭐⭐'; msg = 'Bagus banget! Hampir sempurna!'; }

  document.getElementById('resEmoji').textContent = emoji;
  document.getElementById('resScore').textContent = `${score} / ${total} (${pct}%)`;
  document.getElementById('resStars').textContent = stars;
  document.getElementById('resMsg').textContent = msg;

  const wl = document.getElementById('wrongList');
  if (wrongItems.length === 0) {
    wl.innerHTML = '';
    return;
  }
  wl.innerHTML = `<h3>Perlu Diulang (${wrongItems.length} kata)</h3>` +
    wrongItems.map(w =>
      `<div class="wrong-item">
        <strong>${w.q.jp}</strong> (${w.q.read})<br>
        ✅ ${w.q.id}<br>
        ❌ Kamu pilih: ${mode === 'jp-id' ? w.chosen.id : w.chosen.jp}
      </div>`
    ).join('');
}

function retryQuiz() { startQuiz(); }
function goHome() { showScreen('startScreen'); }
