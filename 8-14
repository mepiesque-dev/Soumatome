<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz Kotoba — Hari 8–14</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --sun: #FFB703;
    --sky: #219EBC;
    --sun-light: #FFD166;
    --sky-light: #8ECAE6;
    --white: #FFFFFF;
    --dark: #1A1A2E;
    --correct: #06D6A0;
    --wrong: #EF476F;
    --radius: 16px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Nunito', sans-serif;
    background: linear-gradient(135deg, var(--sun-light) 0%, var(--sky-light) 100%);
    min-height: 100vh;
    padding: 16px;
  }

  /* ── SCREENS ── */
  .screen { display: none; }
  .screen.active { display: block; }

  /* ── START SCREEN ── */
  #startScreen {
    max-width: 480px;
    margin: 24px auto;
    text-align: center;
  }
  .start-card {
    background: var(--white);
    border-radius: 28px;
    padding: 36px 28px;
    box-shadow: 0 12px 40px rgba(33,158,188,.18);
  }
  .logo { font-family: 'Fredoka One', cursive; font-size: 2.4rem; color: var(--sky); margin-bottom: 4px; }
  .subtitle { color: var(--sun); font-weight: 800; font-size: 1rem; margin-bottom: 18px; }
  .desc { color: #555; font-size: .93rem; margin-bottom: 24px; line-height: 1.5; }

  .mode-row { display: flex; gap: 10px; margin-bottom: 18px; }
  .mode-btn {
    flex: 1; padding: 12px 6px; border: 3px solid var(--sky-light);
    border-radius: 14px; background: #f0faff; cursor: pointer;
    font-family: 'Nunito', sans-serif; font-weight: 700; font-size: .88rem;
    color: var(--sky); transition: all .2s;
  }
  .mode-btn.selected { background: var(--sky); color: #fff; border-color: var(--sky); }

  .count-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 24px; }
  .count-btn {
    padding: 9px 18px; border: 3px solid var(--sun-light);
    border-radius: 12px; background: #fffbf0; cursor: pointer;
    font-family: 'Nunito', sans-serif; font-weight: 700; color: #b07a00;
    transition: all .2s; font-size: .88rem;
  }
  .count-btn.selected { background: var(--sun); color: #fff; border-color: var(--sun); }

  .start-btn {
    width: 100%; padding: 16px; border: none; border-radius: 16px;
    background: linear-gradient(135deg, var(--sun), var(--sky));
    color: #fff; font-family: 'Fredoka One', cursive; font-size: 1.3rem;
    cursor: pointer; box-shadow: 0 6px 20px rgba(33,158,188,.3);
    transition: transform .15s, box-shadow .15s;
  }
  .start-btn:active { transform: scale(.97); }

  /* ── QUIZ SCREEN ── */
  #quizScreen { max-width: 520px; margin: 0 auto; }

  .top-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .progress-wrap { flex: 1; margin: 0 12px; }
  .progress-track {
    background: rgba(255,255,255,.5); border-radius: 99px;
    height: 10px; overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--sun), var(--sky));
    border-radius: 99px; transition: width .4s ease;
  }
  .prog-label { font-size: .78rem; font-weight: 700; color: var(--dark); margin-top: 3px; text-align: right; }

  .score-badge {
    background: var(--white); border-radius: 12px;
    padding: 6px 14px; font-weight: 800;
    color: var(--sky); font-size: .9rem; white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
  }

  .q-card {
    background: var(--white); border-radius: var(--radius);
    padding: 28px 22px 22px;
    box-shadow: 0 8px 30px rgba(33,158,188,.15);
    margin-bottom: 14px;
  }
  .q-day { font-size: .75rem; font-weight: 800; color: var(--sky); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; }
  .q-text { font-size: 1.6rem; font-weight: 800; color: var(--dark); text-align: center; line-height: 1.3; }
  .q-reading { font-size: .95rem; color: #888; text-align: center; margin-top: 6px; }

  .options { display: flex; flex-direction: column; gap: 10px; }
  .opt-btn {
    padding: 14px 18px; border: 3px solid #e8f4f8;
    border-radius: 14px; background: #f7fdff;
    font-family: 'Nunito', sans-serif; font-weight: 700;
    font-size: .92rem; color: var(--dark); cursor: pointer;
    text-align: left; transition: all .18s; line-height: 1.4;
  }
  .opt-btn:hover:not(:disabled) { border-color: var(--sky); background: #e8f7fb; transform: translateX(3px); }
  .opt-btn.correct { background: #e6faf4; border-color: var(--correct); color: #047857; }
  .opt-btn.wrong   { background: #fde8ee; border-color: var(--wrong);   color: #9b1c3a; }
  .opt-btn:disabled { cursor: default; }

  .feedback-bar {
    padding: 12px 18px; border-radius: 12px;
    font-weight: 800; font-size: .92rem; text-align: center;
    margin-bottom: 10px; display: none;
  }
  .feedback-bar.show { display: block; }
  .feedback-bar.ok  { background: #e6faf4; color: #047857; }
  .feedback-bar.ng  { background: #fde8ee; color: #9b1c3a; }

  .next-btn {
    width: 100%; padding: 13px; border: none; border-radius: 14px;
    background: linear-gradient(135deg, var(--sky), var(--sun));
    color: #fff; font-family: 'Fredoka One', cursive; font-size: 1.1rem;
    cursor: pointer; display: none; transition: opacity .2s;
  }
  .next-btn.show { display: block; }

  /* ── RESULT SCREEN ── */
  #resultScreen { max-width: 480px; margin: 24px auto; text-align: center; }
  .result-card {
    background: var(--white); border-radius: 28px;
    padding: 36px 28px; box-shadow: 0 12px 40px rgba(33,158,188,.18);
  }
  .result-emoji { font-size: 3.5rem; margin-bottom: 10px; }
  .result-title { font-family: 'Fredoka One', cursive; font-size: 2rem; color: var(--sky); margin-bottom: 6px; }
  .result-score { font-size: 3rem; font-weight: 800; color: var(--sun); margin: 10px 0; }
  .result-stars { font-size: 2rem; margin-bottom: 14px; }
  .result-msg { color: #555; font-size: .95rem; margin-bottom: 24px; }

  .wrong-list { text-align: left; margin-bottom: 20px; }
  .wrong-list h3 { font-size: .85rem; color: var(--wrong); font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
  .wrong-item {
    background: #fde8ee; border-radius: 12px; padding: 10px 14px;
    margin-bottom: 8px; font-size: .87rem; color: #6b1a2e; line-height: 1.5;
  }
  .wrong-item strong { color: var(--dark); }

  .result-actions { display: flex; gap: 10px; }
  .act-btn {
    flex: 1; padding: 13px; border: none; border-radius: 14px;
    font-family: 'Fredoka One', cursive; font-size: 1rem;
    cursor: pointer; transition: transform .15s;
  }
  .act-btn:active { transform: scale(.97); }
  .act-retry { background: linear-gradient(135deg, var(--sun), #ff9f1c); color: #fff; }
  .act-home  { background: linear-gradient(135deg, var(--sky), #0077b6); color: #fff; }
</style>
</head>
<body>

<!-- ═══════════════ START ═══════════════ -->
<div id="startScreen" class="screen active">
  <div class="start-card">
    <div class="logo">🚃 電車・車・日常</div>
    <div class="subtitle">Buku Kuning — Hari 8 s/d 14</div>
    <div class="desc">203 kosakata seputar transportasi kereta, mobil, lalu lintas, perbankan, kencan, dan persiapan diri. Pilih mode & jumlah soal!</div>

    <div class="mode-row">
      <button class="mode-btn selected" onclick="selectMode('jp-id',this)">🇯🇵 → 🇮🇩<br><small>JP ke Indonesia</small></button>
      <button class="mode-btn" onclick="selectMode('id-jp',this)">🇮🇩 → 🇯🇵<br><small>Indonesia ke JP</small></button>
    </div>

    <div class="count-row">
      <button class="count-btn" onclick="selectCount(10,this)">10 Soal</button>
      <button class="count-btn" onclick="selectCount(20,this)">20 Soal</button>
      <button class="count-btn" onclick="selectCount(30,this)">30 Soal</button>
      <button class="count-btn selected" onclick="selectCount(203,this)">Semua (203)</button>
    </div>

    <button class="start-btn" onclick="startQuiz()">▶ Mulai Latihan!</button>
  </div>
</div>

<!-- ═══════════════ QUIZ ═══════════════ -->
<div id="quizScreen" class="screen">
  <div class="top-bar">
    <div class="score-badge">✅ <span id="scoreVal">0</span></div>
    <div class="progress-wrap">
      <div class="progress-track"><div class="progress-fill" id="progFill" style="width:0%"></div></div>
