    </div>
    <div class="score-badge" id="wrongBadge">❌ 0</div>
  </div>

  <div class="q-card">
    <div class="q-day" id="qDay"></div>
    <div class="q-text" id="qText"></div>
    <div class="q-reading" id="qReading"></div>
  </div>

  <div class="options" id="optionsBox"></div>
  <div class="feedback-bar" id="feedbackBar"></div>
  <button class="next-btn" id="nextBtn" onclick="nextQuestion()">Lanjut →</button>
</div>

<!-- ═══════════════ RESULT ═══════════════ -->
<div id="resultScreen" class="screen">
  <div class="result-card">
    <div class="result-emoji" id="resEmoji"></div>
    <div class="result-title">Hasil Quiz</div>
    <div class="result-score" id="resScore"></div>
    <div class="result-stars" id="resStars"></div>
    <div class="result-msg" id="resMsg"></div>
    <div class="wrong-list" id="wrongList"></div>
    <div class="result-actions">
      <button class="act-btn act-retry" onclick="retryQuiz()">🔄 Ulangi</button>
      <button class="act-btn act-home"  onclick="goHome()">🏠 Menu</button>
    </div>
  </div>
</div>

